# MongoDB Atlas connection string (must be a replica set — Atlas always is — for transactions)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lingodeck

# 32+ random chars: openssl rand -base64 32
SESSION_PASSWORD=

# Email OTP via Resend. Leave empty in dev: the code is printed to the server log instead.
RESEND_API_KEY=
EMAIL_FROM=LingoDeck <login@example.com>

# Cloudflare R2 (S3 API) for audio/image uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lingodeck-media

# Google sign-in (OAuth client, type "Web application"). Redirect URI: <origin>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
